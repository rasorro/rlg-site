RewriteEngine On
Options -Indexes

# Canonical redirects: force https + www and clean URLs.
RewriteCond %{HTTP_HOST} !^www\.reactionlabgames\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://www.reactionlabgames.com%{REQUEST_URI} [R=301,L]

# Old game URL (renamed to /stickman-skydive/).
RewriteRule ^stickman-skydive-simulator(/.*)?$ /stickman-skydive/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# For exported directory routes, prefer canonical trailing slash when a real directory exists.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L]

# Serve pre-compressed Unity .br variants when browser supports brotli (smaller than gzip).
RewriteCond %{HTTP:Accept-Encoding} br
RewriteCond %{REQUEST_URI} \.(data|framework\.js|wasm)$
RewriteCond %{REQUEST_FILENAME}.br -f
RewriteRule ^(.*)$ $1.br [L]

# Keep mod_deflate from compressing the already-compressed .br body again. This has to match
# the rewritten .br request, since variables set before an .htaccess rewrite get a REDIRECT_ prefix.
RewriteRule \.br$ - [E=no-gzip:1]

# Serve pre-compressed .gz variants when browser supports gzip
RewriteCond %{HTTP:Accept-Encoding} gzip
RewriteCond %{REQUEST_URI} !\.(gz|br)$
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^(.*)$ $1.gz [L]

# Serve exported extensionless routes.
# 1) /path or /path/ -> /path/index.html when that file exists.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# 2) Backward-compatible fallback: /path or /path/ -> /path.html when present.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

RewriteRule ^(.*/__next\.[^/]+)\.__PAGE__\.txt$ /$1/__PAGE__.txt [L]

<FilesMatch "\.framework\.js\.gz$">
    Header set Content-Type "application/javascript"
    Header set Content-Encoding "gzip"
    Header append Vary "Accept-Encoding"
</FilesMatch>

<FilesMatch "\.data\.gz$">
    Header set Content-Type "application/octet-stream"
    Header set Content-Encoding "gzip"
    Header append Vary "Accept-Encoding"
</FilesMatch>

<FilesMatch "\.wasm\.gz$">
    Header set Content-Type "application/wasm"
    Header set Content-Encoding "gzip"
    Header append Vary "Accept-Encoding"
</FilesMatch>

<FilesMatch "\.framework\.js\.br$">
    Header set Content-Type "application/javascript"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
</FilesMatch>

<FilesMatch "\.data\.br$">
    Header set Content-Type "application/octet-stream"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
</FilesMatch>

<FilesMatch "\.wasm\.br$">
    Header set Content-Type "application/wasm"
    Header set Content-Encoding "br"
    Header append Vary "Accept-Encoding"
</FilesMatch>

# Unity build filenames include the game version, so these assets can be cached
# for a year without risking that an updated build is hidden behind stale cache.
<FilesMatch "^(RapidPath|StickmanSkydive)-[0-9]+(\.[0-9]+)*\.(data|framework\.js|loader\.js|wasm)(\.gz|\.br)?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Stickman Skydive audio: the manifest is re-checked on every visit (its hashes are the bundles' browser
# cache key); the bundles keep a fixed file name, so they get 30 days. If you ever change one, rename it
# (or shorten the cache below first) so returning visitors don't keep the old copy.
<FilesMatch "^audio\.json$">
    Header set Cache-Control "no-cache"
</FilesMatch>

<FilesMatch "\.bundle$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# Next.js build output is content-hashed, so it never changes under the same name.
<If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
</If>

# Site art keeps its file name when edited, so give it a long but not immutable cache (30 days).
<FilesMatch "\.(webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# Security headers (need mod_headers, which this file already requires).
# nosniff: browsers must trust our declared file types instead of guessing.
Header always set X-Content-Type-Options "nosniff"
# Other sites only see our domain, not the full page address, when a visitor clicks away.
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# Our pages (the games' own iframes included) can only be framed by our own site, so no one can wrap them in a fake page.
Header always set X-Frame-Options "SAMEORIGIN"
# The site never needs these browser features, so switch them off for it and for anything embedded in it.
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
